{
  "name": "@noxy-network/node-sdk",
  "version": "1.0.0",
  "description": "Secure, private, wallet-native push notifications for Web3.",
  "author": "Noxy Network",
  "license": "MIT",
  "keywords": [
    "noxy",
    "noxy-network",
    "push notifications",
    "web3",
    "ai",
    "agent",
    "crypto",
    "post quantum"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/noxy-network/node-sdk.git",
    "directory": "node-sdk"
  },
  "type": "module",
  "main": "dist/bundle.js",
  "types": "dist/bundle.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c && cp src/kyber/kyber.wasm dist/kyber.wasm && mkdir -p dist/proto && cp src/proto/noxy.proto dist/proto/noxy.proto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules && rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.7.13",
    "json-with-bigint": "^3.5.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bluebird": "^3.5.42",
    "eslint": "^10.0.0",
    "rollup": "^4.57.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}